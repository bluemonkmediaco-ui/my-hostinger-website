  "howWeWork": {
    "title": "HOW WE WORK",
    "steps": [
      {
        "id": 1,
        "name": "1. Discovery Call",
        "icon": "phone",
        "desc": "We start with a call to understand your brand, goals, audience and what success looks like."
      },
      {
        "id": 2,
        "name": "2. Strategy Call",
        "icon": "target",
        "desc": "We dive deeper into your objectives and craft the right creative approach."
      },
      {
        "id": 3,
        "name": "3. Ideate & Script",
        "icon": "lightbulb",
        "desc": "We ideate, structure the concept and write a script that brings the idea to life."
      },
      {
        "id": 4,
        "name": "4. Shoot",
        "icon": "video",
        "desc": "We plan, set up and capture the right footage with precision and creativity."
      },
      {
        "id": 5,
        "name": "5. Edit & Design",
        "icon": "monitor",
        "desc": "We edit the video and add motion graphics, sound and polish everything."
      },
      {
        "id": 6,
        "name": "6. Review",
        "icon": "message-square",
        "desc": "We send it to you for revision and make sure it's perfect."
      },
      {
        "id": 7,
        "name": "7. Deliver",
        "icon": "check",
        "desc": "Once approved, we deliver or publish as per your requirements."
      }
    ]
  },
