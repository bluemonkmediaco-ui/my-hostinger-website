  "aboutUs": {
    "title": "ABOUT US",
    "para1": "At Blue Monk Media, we are a full-service creative production house dedicated to turning vision into viral, high-converting visual stories. From high-fashion brand reels to architectural showcases, we blend cinematic artistry with strategic marketing.",
